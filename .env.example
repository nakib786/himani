# =============================================================================
# KSHYOVRATA — environment
#
# Copy to `.env.local` for development. Set the same keys in
# Vercel → Project → Settings → Environment Variables for production.
#
# `.env*` is gitignored except this file. Never commit real values.
# =============================================================================


# -----------------------------------------------------------------------------
# SITE
# -----------------------------------------------------------------------------
# Drives canonical URLs, the sitemap, robots.txt and Open Graph tags. No
# trailing slash. Set it per-environment — a wrong value points every canonical
# at the wrong host.
NEXT_PUBLIC_SITE_URL=https://kshyovrata.com


# -----------------------------------------------------------------------------
# BACKENDS
# -----------------------------------------------------------------------------
# Which source serves the catalogue and the journal. They are separate switches
# on purpose: the shop and the journal are edited by different people, and
# rolling one back should not drag the other with it.
#
#   local  the launch content committed in lib/catalogue.ts / lib/journal.ts
#   wix    live from the Wix site
#
COMMERCE_BACKEND=wix
CONTENT_BACKEND=wix


# -----------------------------------------------------------------------------
# WIX  (required when either backend above is `wix`)
# -----------------------------------------------------------------------------
# Two ways to authenticate. Set ONE pair. If both are present the API key wins.
#
# ---- Option A: API key + site ID (admin) ----
# Generate at https://manage.wix.com/account/api-keys — account owners only.
#
# ⚠ An API key is an ACCOUNT-LEVEL ADMIN credential. It can read and write
#   everything on the site, including orders and customer data. It is used
#   here only for server-side reads, must never be prefixed NEXT_PUBLIC_, and
#   must never be imported into a 'use client' component. lib/wix/client.ts is
#   marked server-only so a mistake fails the build rather than shipping the
#   key to browsers. Rotate it if it is ever pasted anywhere shared.
WIX_API_KEY=
# Wix dashboard → Settings → General, or the URL of your site's dashboard.
WIX_SITE_ID=e94f5cb9-6d60-402f-845d-e31e4f9cf165

# ---- Option B: headless client ID (read-only visitor) ----
# Wix dashboard → Settings → Headless Settings → OAuth apps → Client ID.
# Public identifier, no secret. Mints anonymous visitor tokens that can only
# read published content — the safer option, and enough for this site.
# WIX_CLIENT_ID=

# ---- Shared options ----
# ISR window in seconds for all Wix reads. Default 900 (15 min). Price, stock
# and post edits in Wix appear on the site within this window.
# WIX_REVALIDATE_SECONDS=900
# Only set this if Wix tells you to.
# WIX_API_BASE=https://www.wixapis.com


# -----------------------------------------------------------------------------
# TRANSACTIONAL EMAIL  (not yet wired — see app/api/*/route.ts)
# -----------------------------------------------------------------------------
# The contact and newsletter routes accept and validate submissions but do not
# deliver them anywhere yet. Fill these in and follow the notes in each route.
# RESEND_API_KEY=
# RESEND_AUDIENCE_ID=
# CARE_INBOX=care@kshyovrata.com


# -----------------------------------------------------------------------------
# PAYMENTS  (not yet wired — see app/checkout/CheckoutFlow.tsx)
# -----------------------------------------------------------------------------
# Checkout is real up to the payment step, which is deliberately not faked.
# NEXT_PUBLIC_RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
